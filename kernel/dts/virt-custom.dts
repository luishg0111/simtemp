/dts-v1/;

/ {
    model = "QEMU Virt Machine with nxp-simtemp";
    compatible = "qemu,virt", "nxp,simtemp-board";
    
    #address-cells = <2>;
    #size-cells = <2>;

    memory@40000000 {
        device_type = "memory";
        reg = <0x00000000 0x40000000 0x00000000 0x40000000>;
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a57";
            reg = <0>;
        };
    };

    simtemp {
        compatible = "nxp,simtemp";
        sampling-ms = <100>;
        threshold-mC = <45000>;
        status = "okay";
    };
};